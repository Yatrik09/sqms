# ==========================================================
# SQMS — Environment Configuration
# ==========================================================

# Application
PROJECT_NAME="SQMS — AI-Powered Smart Queue Management System"
VERSION="1.0.0"

# Security
SECRET_KEY="sqms-super-secure-dev-secret-key-automotive-ai-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local SQLite for zero-configuration execution
DATABASE_URL="sqlite:///./sqms.db"
# Alternative PostgreSQL Configuration:
# DATABASE_URL="postgresql://sqms_user:sqms_password@localhost:5432/sqms_db"

# Server Hosts
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_WS_URL="ws://localhost:8000/ws"

# Configurable Recommendation Engine Weights (Must sum to 1.0)
WEIGHT_SERVICE_COMPATIBILITY=0.25
WEIGHT_COMPLETION_FEASIBILITY=0.25
WEIGHT_WAITING_EFFICIENCY=0.20
WEIGHT_CAPACITY_AVAILABILITY=0.15
WEIGHT_DISTANCE=0.15
